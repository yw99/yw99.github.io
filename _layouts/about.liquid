---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid path = profile_image_path class = profile_image_class sizes = sizes alt = page.profile.image
            cache_bust = true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}
    
    <!-- Biography & contact -->
    <div class="clearfix">{{ content }}</div>

    <!-- Research interests -->
    {% if page.interests %}
      <section class="home-section" aria-labelledby="research-interests-heading">
        <h2 id="research-interests-heading">Research interests</h2>
        <div class="row">
          {% for interest in page.interests %}
            <div class="col-md-6 interest-area">
              <p class="interest-name">{{ interest.area }}</p>
              <p class="interest-topics">{{ interest.topics }}</p>
            </div>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <!-- Industry experience -->
    {% if page.industry %}
      <section class="home-section" aria-labelledby="industry-heading">
        <h2 id="industry-heading">Industry experience</h2>
        {% if page.industry.resume %}
          <p class="industry-resume">
            <a href="{{ page.industry.resume | relative_url }}">Industry Resume (PDF)</a>
          </p>
        {% endif %}
        <ul class="industry-list">
          {% for position in page.industry.positions %}
            <li>
              <div class="industry-header">
                <span><strong>{{ position.role }}</strong>, {{ position.company }}</span>
                <span class="industry-date">{{ position.year }}</span>
              </div>
              {% if position.keywords or position.links %}
                <div class="industry-keywords">
                  {{ position.keywords }}
                  {% for link in position.links %}
                    <a href="{{ link.url }}" class="industry-link">[{{ link.name }}]</a>
                  {% endfor %}
                </div>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section class="home-section" aria-labelledby="selected-publications-heading">
        <h2 id="selected-publications-heading">
          <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected publications</a>
        </h2>
        {% include selected_papers.liquid %}
        <p class="view-all-publications">
          <a href="{{ '/publications/' | relative_url }}">Full publication list &rarr;</a>
          (ICML, NeurIPS, ICLR, AISTATS, and more)
        </p>
      </section>
    {% endif %}

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Education & teaching -->
    {% if page.education or page.teaching %}
      <section class="home-section" aria-labelledby="education-teaching-heading">
        <h2 id="education-teaching-heading">Education &amp; teaching</h2>
        <div class="row">
          {% if page.education %}
            <div class="col-md-6">
              <h3 class="section-subheading">Education</h3>
              <ul class="ul-edu mb-0">
                {% for edu in page.education %}
                  <li>
                    <div class="description">
                      <p class="course">{{ edu.course }}, {{ edu.institution }}, {{ edu.year }}</p>
                    </div>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
          {% if page.teaching %}
            <div class="col-md-6">
              <h3 class="section-subheading">
                <a href="{{ '/teaching/' | relative_url }}" style="color: inherit">Teaching assistant</a>
              </h3>
              <ul class="ul-edu mb-0">
                {% for teach in page.teaching %}
                  <li>
                    <div class="description">
                      <p class="teach">
                        {% if teach.url %}<a href="{{ teach.url }}">{{ teach.course }}</a>{% else %}{{ teach.course }}{% endif %}, {{ teach.year }}
                      </p>
                    </div>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        </div>
      </section>
    {% endif %}

    <!-- About me -->
    {% if page.about_me %}
      <section class="home-section" aria-labelledby="about-me-heading">
        <h2 id="about-me-heading">About me</h2>
        {{ page.about_me | markdownify }}
      </section>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">my posts for fun</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </article>
</div>
