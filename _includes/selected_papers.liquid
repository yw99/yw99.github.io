<div class="publications mt-2 mb-3">
  {% comment %}
    If the page lists citation keys in `selected_papers`, show exactly those, in that order.
    Otherwise (selected_papers: true) fall back to the entries marked selected={true}.
  {% endcomment %}
  {% if page.selected_papers.first %}
    {% for paper_key in page.selected_papers %}
      {% bibliography --group_by none --query @*[key={{paper_key}}]* %}
    {% endfor %}
  {% else %}
    {% bibliography --group_by none --query @*[selected=true&&ongoing!=true]* %}
  {% endif %}
</div>
